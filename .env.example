COMPOSE_PROJECT_NAME=scitrace

# ---------------------------------------------------------------------------
# Aplicación Laravel
# ---------------------------------------------------------------------------
APP_NAME="SciTrace AI"
APP_VERSION=0.1.0
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_EC
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null

# ---------------------------------------------------------------------------
# Base de datos PostgreSQL
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=scitrace
DB_USERNAME=scitrace
DB_PASSWORD=
DB_SSLMODE=prefer

# ---------------------------------------------------------------------------
# Redis (caché y colas; no se publica fuera de la red de Docker)
# ---------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false

# ---------------------------------------------------------------------------
# Correo (Mailpit en desarrollo)
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS=no-reply@scitrace.local
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Microservicio de IA
# Solo accesible desde la red interna de Docker.
# ---------------------------------------------------------------------------
AI_SERVICE_URL=http://ai:8000
AI_INTERNAL_TOKEN=
AI_TIMEOUT_SECONDS=5
AI_CONNECT_TIMEOUT_SECONDS=2
AI_EXTRACTION_TIMEOUT_SECONDS=120

# Servicio de IA (FastAPI)
AI_ENVIRONMENT=local
AI_LOG_LEVEL=INFO
# El detector se habilita solo cuando el artefacto existe y supera la
# verificación SHA-256 contra card.json. Si no, /detect responde 503.
AI_DETECTOR_ENABLED=true
AI_DETECTOR_READY=true
AI_MODEL_DIR=models/scitrace-es-v1
AI_MAX_DOCUMENT_BYTES=26214400
AI_MAX_SEGMENTS=10000
AI_OCR_ENABLED=true
AI_OCR_LANGUAGES=spa+eng
AI_OCR_DPI=200
AI_MIN_TEXT_CHARS_PER_PAGE=20

# ---------------------------------------------------------------------------
# Administrador inicial. Se crea solo si el correo y la contraseña están
# definidos. La contraseña debe tener al menos 12 caracteres.
# scripts/bootstrap.ps1 genera una si se deja vacía.
# ---------------------------------------------------------------------------
SCITRACE_ADMIN_NAME="Administrador SciTrace"
SCITRACE_ADMIN_EMAIL=admin@scitrace.local
SCITRACE_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Retención (días). Se aplicará en la Fase 6.
# ---------------------------------------------------------------------------
SCITRACE_DOCUMENT_RETENTION_DAYS=365

# ---------------------------------------------------------------------------
# Documentos (Fase 2)
# ---------------------------------------------------------------------------
SCITRACE_DOCUMENTS_DISK=local
SCITRACE_MAX_UPLOAD_KB=25600
SCITRACE_MAX_SEGMENTS=10000
SCITRACE_MAX_SEGMENT_CHARS=200000

# ---------------------------------------------------------------------------
# Docker / desarrollo
# ---------------------------------------------------------------------------
UID=1000
GID=1000
