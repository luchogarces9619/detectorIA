# Entorno y secretos
.env
.env.*
!.env.example
!.env.docker.example
*.pem
*.key

# Dependencias y artefactos de Laravel
/src/vendor/
/src/node_modules/
/src/public/build/
/src/public/hot
/src/public/storage
/src/storage/*.key
/src/storage/app/private/*
!/src/storage/app/private/.gitignore
/src/storage/app/public/*
!/src/storage/app/public/.gitignore
/src/storage/framework/cache/data/*
/src/storage/framework/sessions/*
/src/storage/framework/testing/*
/src/storage/framework/views/*
/src/storage/logs/*
!/src/storage/logs/.gitignore

# Python
ai-service/.venv/
ai-service/__pycache__/
ai-service/.pytest_cache/
ai-service/.ruff_cache/
ai-service/**/__pycache__/
ai-service/**/*.pyc
ai-service/htmlcov/
ai-service/.coverage

# Corpus de entrenamiento (textos de terceros y sintéticos; se regenera)
ai-service/data/

# Herramientas locales
/tools/
/.idea/
/.vscode/
*.log
Thumbs.db
desktop.ini
